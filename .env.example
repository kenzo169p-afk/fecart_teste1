# =========================================================================
# CONFIGURAÇÃO DO SUPABASE (BANCO DE DADOS PRINCIPAL)
# =========================================================================
# URL de API REST do seu projeto Supabase (encontrada em Settings > API)
SUPABASE_URL=https://sua-url-aqui.supabase.co

# Chave Anônima Pública (Anon Key) para o Frontend
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx.yyyy

# Chave de Serviço (Service Role Key) para o Monitor de Auditoria do Backend
# (Necessária para contornar políticas RLS e gravar logs de segurança)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service-role-key-here.zzzz

# =========================================================================
# SEGURANÇA E INTEGRIDADE DE CÓDIGO (AUDITORIA)
# =========================================================================
# Chave Secreta para autorizar edições de código legítimas
# Use esta chave ao rodar: python backend/authorize_changes.py
AUDIT_SECRET_KEY=ChaveSecretaAuditoriaDeCodigo123!

# =========================================================================
# CONFIGURAÇÃO DE PORTAS E EXECUÇÃO
# =========================================================================
# Porta do Servidor Flask Backend
PORT=5000
